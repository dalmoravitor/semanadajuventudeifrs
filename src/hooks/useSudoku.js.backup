import { useState, useEffect, useCallback } from 'react';
import { doc, getDoc, setDoc, updateDoc } from 'firebase/firestore';
import { db } from '../api/firebase';
import { getEquipes } from '../api/equipes';

/**
 * Hook para gerenciar competição de Sudoku com múltiplas etapas
 * 
 * REGRAS:
 * - Primeira Fase: 3 subdivisões (5, 5, 6 equipes)
 *   - Rodada 1: Cada subdivisão resolve 1 sudoku (máx 10min)
 *   - Rodada 2: Cada subdivisão resolve mais 1 sudoku (máx 10min)
 *   - Classificam: 2 melhores de cada subdivisão pelo SOMATÓRIO das 2 rodadas (6 equipes)
 *   - Penalidades: ≤3 erros = +15min | >3 erros/NC = 16min
 * 
 * - Segunda Fase (Semifinal): 6 equipes juntas
 *   - 3 sudokus (máx 15min cada)
 *   - Penalidades: ≤3 erros = +22min | >3 erros/NC = 25min
 *   - Classificam: 3 melhores pelo somatório dos 3 sudokus
 *   - OBS: Tempos da primeira fase NÃO contam (apenas como desempate)
 * 
 * - Fase Final: 3 equipes
 *   - 2 sudokus simultâneos
 *   - Erro = desclassificação
 *   - Rodadas até classificar 1º, 2º, 3º
 * 
 * - Classificação Final:
 *   - 7º a 16º: Primeira fase (10 eliminados)
 *   - 4º a 6º: Semifinal (3 eliminados)
 *   - 1º a 3º: Final
 * 
 * Estrutura do documento no Firestore:
 * sudoku/{modalidadeId} = {
 *   modalidadeId: string,
 *   faseAtual: string ('primeira' | 'semifinal' | 'final' | 'concluido'),
 *   primeiraFase: {
 *     subdivisoes: [
 *       { 
 *         nome: 'Subdivisão 1', 
 *         equipes: [...],
 *         rodada1: {...}, // resultados da rodada 1
 *         rodada2: {...}, // resultados da rodada 2
 *         somatorios: {...} // tempo1 + tempo2
 *       },
 *       ...
 *     ],
 *     classificados: [...], // 2 por subdivisão = 6 equipes
 *     eliminados: [...] // 10 equipes (classificação 7º-16º)
 *   },
 *   semifinal: {
 *     equipes: [...], // 6 equipes
 *     resultados: {...}, // 3 sudokus por equipe
 *     classificados: [...], // 3 melhores
 *     eliminados: [...] // 3 equipes (classificação 4º-6º)
 *   },
 *   final: {
 *     equipes: [...], // 3 equipes
 *     rodadas: [...],
 *     classificacaoFinal: [...] // 1º, 2º, 3º
 *   },
 *   classificacaoGeral: [...] // 1º a 16º
 * }
 */
export function useSudoku(modalidadeId) {
  const [loading, setLoading] = useState(true);
  const [todasEquipes, setTodasEquipes] = useState([]);
  const [faseAtual, setFaseAtual] = useState('primeira'); // 'primeira' | 'semifinal' | 'final' | 'concluido'
  const [dados, setDados] = useState({
    primeiraFase: {
      subdivisoes: [
        { nome: 'Subdivisão 1 (5 equipes)', equipes: [], rodada1: {}, rodada2: {}, somatorios: {} },
        { nome: 'Subdivisão 2 (5 equipes)', equipes: [], rodada1: {}, rodada2: {}, somatorios: {} },
        { nome: 'Subdivisão 3 (6 equipes)', equipes: [], rodada1: {}, rodada2: {}, somatorios: {} }
      ],
      classificados: [], // 6 equipes
      eliminados: [] // 10 equipes (7º a 16º)
    },
    semifinal: {
      equipes: [],
      resultados: {}, // 3 sudokus por equipe
      classificados: [], // 3 equipes
      eliminados: [] // 3 equipes (4º a 6º)
    },
    final: {
      equipes: [],
      rodadas: [],
      classificacaoFinal: [] // 1º, 2º, 3º
    },
    classificacaoGeral: [] // 1º a 16º
  });

  // ========================================
  // CARREGAR DADOS DO FIREBASE
  // ========================================
  
  useEffect(() => {
    const carregarDados = async () => {
      if (!modalidadeId) {
        setLoading(false);
        return;
      }

      try {
        // Carregar lista de todas as equipes do sistema
        const responseEquipes = await getEquipes();
        if (responseEquipes.success) {
          setTodasEquipes(responseEquipes.data);
        }

        const docRef = doc(db, 'sudoku', modalidadeId);
        const docSnap = await getDoc(docRef);

        if (docSnap.exists()) {
          const dadosFirestore = docSnap.data();
          
          if (dadosFirestore.faseAtual) {
            setFaseAtual(dadosFirestore.faseAtual);
          }
          
          if (dadosFirestore.primeiraFase) {
            setDados(prev => ({
              ...prev,
              primeiraFase: dadosFirestore.primeiraFase,
              semifinal: dadosFirestore.semifinal || prev.semifinal,
              final: dadosFirestore.final || prev.final,
              classificacaoGeral: dadosFirestore.classificacaoGeral || []
            }));
          }
        }
      } catch (error) {
        console.error('Erro ao carregar dados do Sudoku:', error);
      } finally {
        setLoading(false);
      }
    };

    carregarDados();
  }, [modalidadeId]);

  // ========================================
  // AUTO-CLASSIFICAÇÃO PRIMEIRA FASE
  // ========================================
  
  useEffect(() => {
    if (loading || faseAtual !== 'primeira') return;

    // Verificar se todas as subdivisões têm RODADA 1 E RODADA 2 completas
    const todasCompletas = dados.primeiraFase.subdivisoes.every(subdivisao => {
      if (subdivisao.equipes.length === 0) return false;
      
      return subdivisao.equipes.every(equipe => {
        return subdivisao.rodada1[equipe.id] !== undefined &&
               subdivisao.rodada2[equipe.id] !== undefined;
      });
    });

    // Se todas completas e ainda não calculou somatórios, calcular
    if (todasCompletas && Object.keys(dados.primeiraFase.subdivisoes[0].somatorios).length === 0) {
      console.log('📊 Primeira Fase completa! Calculando somatórios e classificando...');
      
      setDados(prev => {
        const novosDados = { ...prev };
        const todosClassificados = [];
        const todosEliminados = [];
        
        // Para cada subdivisão
        novosDados.primeiraFase.subdivisoes.forEach((subdivisao, idx) => {
          // Calcular somatórios (rodada1 + rodada2)
          subdivisao.equipes.forEach(equipe => {
            const tempo1 = subdivisao.rodada1[equipe.id]?.tempoPenalizado || 0;
            const tempo2 = subdivisao.rodada2[equipe.id]?.tempoPenalizado || 0;
            subdivisao.somatorios[equipe.id] = tempo1 + tempo2;
          });
          
          // Ordenar por somatório e classificar 2 melhores
          const resultadosOrdenados = subdivisao.equipes
            .map(equipe => ({
              equipe,
              somatorio: subdivisao.somatorios[equipe.id]
            }))
            .sort((a, b) => a.somatorio - b.somatorio);
          
          const classificados = resultadosOrdenados.slice(0, 2);
          const eliminados = resultadosOrdenados.slice(2);
          
          todosClassificados.push(...classificados.map(r => r.equipe));
          todosEliminados.push(...eliminados.map(r => r.equipe));
        });
        
        novosDados.primeiraFase.classificados = todosClassificados;
        novosDados.primeiraFase.eliminados = todosEliminados;
        
        // Salvar no Firebase
        salvarNoFirebase({
          primeiraFase: novosDados.primeiraFase
        });
        
        return novosDados;
      });
    }
  }, [dados, loading, faseAtual, salvarNoFirebase]);

  // ========================================
  // AUTO-CLASSIFICAÇÃO SEMIFINAL
  // ========================================
  
  useEffect(() => {
    if (loading || faseAtual !== 'semifinal') return;

    // Verificar se todas as equipes têm resultados dos 3 sudokus
    const todasCompletas = dados.semifinal.equipes.length > 0 && 
      dados.semifinal.equipes.every(equipe => {
        const resultado = dados.semifinal.resultados[equipe.id];
        return resultado && 
               resultado.sudoku1 && 
               resultado.sudoku2 && 
               resultado.sudoku3 && 
               resultado.somatorio !== undefined;
      });

    // Se todas completas e ainda não classificou
    if (todasCompletas && dados.semifinal.classificados.length === 0) {
      console.log('🏆 Semifinal completa! Classificando automaticamente...');
      
      setDados(prev => {
        const novosDados = { ...prev };
        
        const resultadosOrdenados = novosDados.semifinal.equipes
          .map(equipe => ({
            equipe,
            resultado: novosDados.semifinal.resultados[equipe.id]
          }))
          .sort((a, b) => a.resultado.somatorio - b.resultado.somatorio);
        
        novosDados.semifinal.classificados = resultadosOrdenados.slice(0, 3).map(r => r.equipe);
        novosDados.semifinal.eliminados = resultadosOrdenados.slice(3).map(r => r.equipe);
        
        // Salvar no Firebase
        salvarNoFirebase({
          semifinal: novosDados.semifinal
        });
        
        return novosDados;
      });
    }
  }, [dados, loading, faseAtual, salvarNoFirebase]);

  // ========================================
  // SALVAR NO FIREBASE
  // ========================================
  
  const salvarNoFirebase = useCallback(async (dadosAtualizados) => {
    if (!modalidadeId) return;

    try {
      const docRef = doc(db, 'sudoku', modalidadeId);
      const docSnap = await getDoc(docRef);

      const timestamp = new Date().toISOString();
      
      if (docSnap.exists()) {
        await updateDoc(docRef, {
          ...dadosAtualizados,
          updatedAt: timestamp
        });
      } else {
        await setDoc(docRef, {
          modalidadeId,
          etapaAtual: 1,
          etapas: dados,
          ...dadosAtualizados,
          createdAt: timestamp,
          updatedAt: timestamp
        });
      }
    } catch (error) {
      console.error('Erro ao salvar no Firebase:', error);
      throw error;
    }
  }, [modalidadeId, dados]);

  // ========================================
  // FUNÇÕES DE MANIPULAÇÃO - ETAPA 1
  // ========================================

  const salvarEquipesEtapa1 = useCallback(async (subdivisaoIdx, equipesIds) => {
    const equipesCompletas = equipesIds
      .map(id => todasEquipes.find(eq => eq.id === id))
      .filter(Boolean);

    setDados(prev => {
      const novosDados = { ...prev };
      novosDados.etapa1.subdivisoes[subdivisaoIdx].equipes = equipesCompletas;
      
      // Salvar no Firebase
      salvarNoFirebase({
        etapas: novosDados,
        etapaAtual: 1
      });
      
      return novosDados;
    });
  }, [todasEquipes, salvarNoFirebase]);

  const salvarResultadoEtapa1 = useCallback(async (subdivisaoIdx, equipeId, tempo, erros) => {
    setDados(prev => {
      const novosDados = { ...prev };
      
      // Calcular tempo com penalidades
      let tempoPenalizado = Number(tempo);
      if (erros > 3 || tempo === null || tempo === '') {
        tempoPenalizado = 16 * 60; // 16 minutos em segundos
      } else if (erros > 0 && erros <= 3) {
        tempoPenalizado = Number(tempo) + (15 * 60); // +15 min
      }
      
      novosDados.etapa1.subdivisoes[subdivisaoIdx].resultados[equipeId] = {
        tempo: Number(tempo) || null,
        erros: Number(erros),
        tempoPenalizado,
        timestamp: new Date().toISOString()
      };
      
      // Salvar no Firebase
      salvarNoFirebase({ etapas: novosDados });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  const classificarEtapa1 = useCallback(async () => {
    setDados(prev => {
      const novosDados = { ...prev };
      const classificados = [];
      
      // Para cada subdivisão, pegar os 2 melhores
      novosDados.etapa1.subdivisoes.forEach(subdivisao => {
        const resultadosOrdenados = subdivisao.equipes
          .map(equipe => ({
            equipe,
            resultado: subdivisao.resultados[equipe.id] || { tempoPenalizado: Infinity }
          }))
          .sort((a, b) => a.resultado.tempoPenalizado - b.resultado.tempoPenalizado)
          .slice(0, 2); // 2 primeiros
        
        classificados.push(...resultadosOrdenados.map(r => r.equipe));
      });
      
      novosDados.etapa1.classificados = classificados;
      
      // Salvar e avançar para etapa 2
      setEtapaAtual(2);
      salvarNoFirebase({
        etapas: novosDados,
        etapaAtual: 2
      });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  // ========================================
  // FUNÇÕES DE MANIPULAÇÃO - ETAPA 2
  // ========================================

  const iniciarEtapa2 = useCallback(async () => {
    setDados(prev => {
      const novosDados = { ...prev };
      
      // Pegar os eliminados da etapa 1 (16 - 6 = 10 equipes)
      const todasEquipesEtapa1 = novosDados.etapa1.subdivisoes.flatMap(s => s.equipes);
      const eliminados = todasEquipesEtapa1.filter(
        eq => !novosDados.etapa1.classificados.find(c => c.id === eq.id)
      );
      
      // Distribuir em subdivisões (5, 5, 6) - precisa de 16 equipes novas ou reciclar
      // Vou assumir que temos 16 novas equipes ou reciclamos as mesmas
      
      return novosDados;
    });
  }, []);

  const salvarEquipesEtapa2 = useCallback(async (subdivisaoIdx, equipesIds) => {
    const equipesCompletas = equipesIds
      .map(id => todasEquipes.find(eq => eq.id === id))
      .filter(Boolean);

    setDados(prev => {
      const novosDados = { ...prev };
      novosDados.etapa2.subdivisoes[subdivisaoIdx].equipes = equipesCompletas;
      
      salvarNoFirebase({ etapas: novosDados });
      
      return novosDados;
    });
  }, [todasEquipes, salvarNoFirebase]);

  const salvarResultadoEtapa2 = useCallback(async (subdivisaoIdx, equipeId, tempo, erros) => {
    setDados(prev => {
      const novosDados = { ...prev };
      
      let tempoPenalizado = Number(tempo);
      if (erros > 3 || tempo === null || tempo === '') {
        tempoPenalizado = 16 * 60;
      } else if (erros > 0 && erros <= 3) {
        tempoPenalizado = Number(tempo) + (15 * 60);
      }
      
      novosDados.etapa2.subdivisoes[subdivisaoIdx].resultados[equipeId] = {
        tempo: Number(tempo) || null,
        erros: Number(erros),
        tempoPenalizado,
        timestamp: new Date().toISOString()
      };
      
      salvarNoFirebase({ etapas: novosDados });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  const classificarEtapa2 = useCallback(async () => {
    setDados(prev => {
      const novosDados = { ...prev };
      const classificados = [];
      
      novosDados.etapa2.subdivisoes.forEach(subdivisao => {
        const resultadosOrdenados = subdivisao.equipes
          .map(equipe => ({
            equipe,
            resultado: subdivisao.resultados[equipe.id] || { tempoPenalizado: Infinity }
          }))
          .sort((a, b) => a.resultado.tempoPenalizado - b.resultado.tempoPenalizado)
          .slice(0, 2);
        
        classificados.push(...resultadosOrdenados.map(r => r.equipe));
      });
      
      novosDados.etapa2.classificados = classificados;
      
      // Juntar com classificados da etapa 1 para formar etapa 3 (6 + 6 = 12? ou apenas 6 da etapa 2?)
      // Vou assumir que são os 6 da etapa 1 que vão para etapa 3
      novosDados.etapa3.equipes = novosDados.etapa1.classificados;
      
      setEtapaAtual(3);
      salvarNoFirebase({
        etapas: novosDados,
        etapaAtual: 3
      });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  // ========================================
  // FUNÇÕES DE MANIPULAÇÃO - ETAPA 3 (SEMIFINAL)
  // ========================================

  const salvarResultadoEtapa3 = useCallback(async (equipeId, sudoku1, sudoku2, sudoku3) => {
    setDados(prev => {
      const novosDados = { ...prev };
      
      // Cada sudoku tem tempo e erros
      const calcularTempo = (tempo, erros) => {
        let tempoPenalizado = Number(tempo);
        if (erros > 3 || tempo === null || tempo === '') {
          tempoPenalizado = 25 * 60;
        } else if (erros > 0 && erros <= 3) {
          tempoPenalizado = Number(tempo) + (22 * 60);
        }
        return tempoPenalizado;
      };
      
      const tempo1 = calcularTempo(sudoku1.tempo, sudoku1.erros);
      const tempo2 = calcularTempo(sudoku2.tempo, sudoku2.erros);
      const tempo3 = calcularTempo(sudoku3.tempo, sudoku3.erros);
      
      const somatorio = tempo1 + tempo2 + tempo3;
      
      novosDados.etapa3.resultados[equipeId] = {
        sudoku1: { ...sudoku1, tempoPenalizado: tempo1 },
        sudoku2: { ...sudoku2, tempoPenalizado: tempo2 },
        sudoku3: { ...sudoku3, tempoPenalizado: tempo3 },
        somatorio,
        timestamp: new Date().toISOString()
      };
      
      salvarNoFirebase({ etapas: novosDados });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  const classificarEtapa3 = useCallback(async () => {
    setDados(prev => {
      const novosDados = { ...prev };
      
      const resultadosOrdenados = novosDados.etapa3.equipes
        .map(equipe => ({
          equipe,
          resultado: novosDados.etapa3.resultados[equipe.id] || { somatorio: Infinity }
        }))
        .sort((a, b) => a.resultado.somatorio - b.resultado.somatorio)
        .slice(0, 3);
      
      novosDados.etapa3.classificados = resultadosOrdenados.map(r => r.equipe);
      novosDados.final.equipes = resultadosOrdenados.map(r => r.equipe);
      
      setEtapaAtual(4);
      salvarNoFirebase({
        etapas: novosDados,
        etapaAtual: 4
      });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  // ========================================
  // FUNÇÕES DE MANIPULAÇÃO - FINAL
  // ========================================

  const salvarRodadaFinal = useCallback(async (rodadaIdx, resultados) => {
    setDados(prev => {
      const novosDados = { ...prev };
      
      if (!novosDados.final.rodadas[rodadaIdx]) {
        novosDados.final.rodadas[rodadaIdx] = { resultados: {}, eliminados: [] };
      }
      
      // resultados = { equipeId: { sudoku1: {...}, sudoku2: {...}, erros: number } }
      novosDados.final.rodadas[rodadaIdx].resultados = resultados;
      
      salvarNoFirebase({ etapas: novosDados });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  const finalizarCompetição = useCallback(async (classificacao) => {
    setDados(prev => {
      const novosDados = { ...prev };
      novosDados.final.classificacaoFinal = classificacao; // [1º, 2º, 3º]
      
      salvarNoFirebase({
        etapas: novosDados,
        etapaAtual: 5, // Concluído
        status: 'concluido'
      });
      
      return novosDados;
    });
  }, [salvarNoFirebase]);

  // ========================================
  // RETORNO DO HOOK
  // ========================================

  return {
    loading,
    todasEquipes,
    etapaAtual,
    dados,
    
    // Etapa 1
    salvarEquipesEtapa1,
    salvarResultadoEtapa1,
    classificarEtapa1,
    
    // Etapa 2
    iniciarEtapa2,
    salvarEquipesEtapa2,
    salvarResultadoEtapa2,
    classificarEtapa2,
    
    // Etapa 3
    salvarResultadoEtapa3,
    classificarEtapa3,
    
    // Final
    salvarRodadaFinal,
    finalizarCompetição
  };
}
