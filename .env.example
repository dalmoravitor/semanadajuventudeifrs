# Configuração web do Firebase (Console → Configurações do projeto → Seus apps).
# Esses valores identificam o projeto e não são segredos; a proteção dos dados
# vem das regras em firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=semanadajuventudeifrs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=semanadajuventudeifrs
VITE_FIREBASE_STORAGE_BUCKET=semanadajuventudeifrs.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true para usar o Firebase Emulator local (npm run emulador)
VITE_USAR_EMULADOR=false
