{
  "name": "semana-da-juventude",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Site da XXIX Semana da Juventude do IFRS Campus Sertão (edição 2025)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dados:exportar": "node scripts/exportar-dados-2025.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:regras": "firebase emulators:exec --only firestore --project demo-semana \"vitest run --config vitest.regras.config.ts\"",
    "emulador": "firebase emulators:start --only firestore,auth",
    "emulador:dados": "node scripts/carregar-emulador.mjs",
    "dev:emulador": "VITE_USAR_EMULADOR=true vite",
    "deploy": "npm run check && firebase deploy --only hosting",
    "deploy:regras": "npm run test:regras && firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
